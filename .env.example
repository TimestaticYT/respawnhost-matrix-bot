# --- Matrix ---------------------------------------------------------------
# Client-server API URL of the bot account's homeserver.
MATRIX_HOMESERVER_URL=https://matrix.example.org
# Access token of the bot account (see README: "Create the bot account").
MATRIX_ACCESS_TOKEN=syt_...
# Command room: room ID (!abc123:example.org) or alias (#vintagestory:example.org).
# Must NOT be end-to-end encrypted. Invite the bot, or make the room joinable.
MATRIX_ROOM=#vintagestory:example.org

# --- RespawnHost ----------------------------------------------------------
# API key with the "servers" scope, created in the RespawnHost dashboard.
RESPAWNHOST_API_KEY=rsp_...
# UUID of the server to control (the one in the panel URL, or run `npm run probe` to check it).
RESPAWNHOST_SERVER_UUID=

# --- Who may do what ------------------------------------------------------
# Comma- or space-separated. Matching ignores upper/lower case.
# May use start, status, ip:
ALLOWED_USERS=@friend:matrix.org
# Everyone on these homeservers counts as allowed (server name after ":" in @user:example.org):
ALLOWED_HOMESERVERS=example.org
# May additionally use stop, restart, kill:
ADMIN_USERS=@daniel:example.org

# --- Optional -------------------------------------------------------------
# Name used in messages. Default: the server alias from RespawnHost.
#SERVER_NAME=Vintage Story
# Address shown to players. Default: read from the RespawnHost API.
#SERVER_ADDRESS=vs.example.org:42420
# First word of every command: "!rh start", "!rh status", ... Default: !rh
#COMMAND_NAMESPACE=!vs
# How long to wait for "online" after a start before giving up. Default: 600
#STARTUP_TIMEOUT_SECONDS=600
